# ================= DeepSeek API =================
# 必填！到 https://platform.deepseek.com/api_keys 创建并粘贴
DEEPSEEK_API_KEY=
# 官方接口地址（一般不用改）
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名：deepseek-chat（对话模型）或 deepseek-reasoner（推理模型，更慢更贵）
DEEPSEEK_MODEL=deepseek-chat
# 留空=沿用服务端默认；none=关闭，low/high/max=开启并指定强度。仅影响DeepSeek。
DEEPSEEK_REASONING_EFFORT=

# ================= 视觉模型（通义千问，读图/表情包用，可选）=================
# 留空则消息里的图片只显示为占位符；填上后，带图消息会自动走视觉模型识图
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-vl-plus
# 支持混合思考的千问辅助模型默认关闭思考，避免长总结大量推理导致超时
DASHSCOPE_ENABLE_THINKING=0
# 单条消息最多识别的图片数 / 单张图片最大字节数 / 图片下载超时（毫秒）
VISION_MAX_IMAGES=4
VISION_MAX_IMAGE_BYTES=6291456
VISION_IMAGE_TIMEOUT_MS=20000

# ================= OneBot / NapCat =================
# NapCat 的正向 WebSocket 服务端地址（默认 3001 端口）
ONEBOT_WS_URL=ws://127.0.0.1:3001
# 若 NapCat 网络配置里设置了 Access Token，填在这里（两边必须一致）
ONEBOT_ACCESS_TOKEN=

# ================= LLBot（LuckyLillia）WebUI =================
# 控制台「QQ 登录」页换号/扫码时调用它；默认 3080
LLBOT_WEBUI_URL=http://127.0.0.1:3080
# LLBot 数据目录下的 webui_token.txt（留空按常见部署位置自动查找）
LLBOT_WEBUI_TOKEN_FILE=
# 启动时交给 LLBot 的账号（--qq）：有它就用保存的登录态恢复，重启不会退到扫码
LLBOT_QQ=
# 临时抓协议层断开原因：设为 1 时给 LLBot 加 --debug（只影响日志详细度，日志会变大）
LLBOT_DEBUG=

# ================= NapCat WebUI（用 NapCat 启动时）=================
# 换号后端：auto=能用 LLBot 就用 LLBot，否则 NapCat；也可写死 llbot / napcat
LOGIN_PROVIDER=auto
# 留空则从 NAPCAT_DIR/config/webui.json 读地址与 token
NAPCAT_WEBUI_URL=
NAPCAT_WEBUI_TOKEN=

# ================= 机器人行为 =================
# 机器人的名字（用于人设）
BOT_NAME=Koukou
# 白名单群号，逗号分隔；这些群里除了被@必回，还有一定概率主动搭话
WHITELIST_GROUPS=
# 白名单群里主动搭话的概率（0~1，0.1 即 10%）
PROACTIVE_RATE=0.1
# 按群独立概率（覆盖上面的全局值），格式 群号:概率，逗号分隔；未列出的群用 PROACTIVE_RATE
# 消息量少的群可以调高一点，否则一天只说两三次、看起来像没触发
# 例：PROACTIVE_RATE_PER_GROUP=200000019:0.35,200000017:0.3
PROACTIVE_RATE_PER_GROUP=
# 白名单群主动搭话最短间隔（毫秒，防止短时间内连续插话；0=不限制）
PROACTIVE_COOLDOWN_MS=180000
# 每个会话保留的历史消息条数（越大越记事儿，越费 token）
HISTORY_LIMIT=20
# 采样温度（0~2，越高越随性）
TEMPERATURE=1.2
# 单次回复最大 token 数（256～200000，控制台可即时改）
# 开思考强度时别低于 2000，否则推理会把预算烧光、正文为空
MAX_TOKENS=4096
# 单次请求超时（毫秒）
TIMEOUT_MS=90000
# 请求失败后的重试次数（网络错误/429/5xx 才会重试）
MAX_RETRIES=2
# 同时进行的 DeepSeek 请求数上限（防止群聊刷屏时打爆限流）
MAX_CONCURRENCY=2
# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# ================= 回复长度自适应 / 多行分条 =================
# 1=开启：回复长度跟着对方消息长度走（你说得短我也短，你说得长我也长）0=固定单行
REPLY_LENGTH_MATCH=1
# 最多分几行（1~5）；分行时每一行会作为一条独立消息分开发送（真人分条发消息的节奏）
REPLY_MAX_LINES=3
# 单行字数上限
REPLY_LINE_MAX_CHARS=40
# 分条发送之间的补句间隔（毫秒）——比首次"打字"延迟短，像人说完一句又补一句
LINE_GAP_MIN_MS=500
LINE_GAP_MAX_MS=1600

# ================= 群内自动 +1 =================
# 1=开启；仅白名单群，群友连续两条相同文字（可夹QQ自带表情）后原生跟一次；图片/图片表情包/纯QQ表情不跟读。
# 同一连续段只跟一次；自己的消息不计数、不起头；独立于普通聊天开关/静音/安静时段。
# 不下载图片、不调用 LLM。NapCat WebSocket 服务端需开启 reportSelfMessage。
AUTO_PLUS_ONE_ENABLED=0

# ================= 每日群聊总结 =================
# 每天自动总结群聊并发到群里（1=开 0=关）
SUMMARY_ENABLED=1
# 每天运行时间（HH:mm，逗号分隔可多个，如 23:00）
SUMMARY_TIMES=23:00
# 1=每天 23:30 仅对确定 23:00 未发送报告的群补一次；须 QQ 实际在线。
# 已发送（含部分发送）、仍在生成或无法核验时不补；离线跳过，恢复登录不追补。
SUMMARY_FALLBACK_ENABLED=0
# 总结目标群（逗号分隔；留空则使用 WHITELIST_GROUPS）
SUMMARY_GROUPS=
# 参与总结的消息条数上限（超出优先普通文字，覆盖完整时间窗口，控制 token 成本）
# 宽裕模式：完整主聊天记录、不传本地输出token限制、整份总结不设总时限，单次无响应仍有限恢复；服务商自身限制仍生效。
SUMMARY_UNRESTRICTED=0
# 宽裕模式每次模型尝试的等待秒数，60～3600；超时有限重试，不是整份总结总时限。
SUMMARY_REQUEST_TIMEOUT_SECONDS=900
SUMMARY_MAX_MESSAGES=600
# 仅用于选题识别的已知机器人QQ，逗号分隔；不改变原始消息统计，默认不预置个人账号。
SUMMARY_BOT_USERS=
# 总结用的模型（默认便宜的 flash；可改 deepseek-v4-pro 效果更好）
SUMMARY_MODEL=deepseek-v4-flash
# 报告发送方式：forward=打包成"聊天记录"合并转发卡片（失败自动退回逐条发送）split=按空行逐条发
SUMMARY_SEND_MODE=forward
# 合并转发卡片最多几条（超出分成多张卡片，保留每个条目的边界）
SUMMARY_MAX_BLOCKS=20
# 喂给模型的"每人数据"行数（「群友称号」一节据此写，数字由代码精确统计）
SUMMARY_USER_ROWS=20

# ================= 联网搜索（百度千帆 AI Search）=================
# 留空则禁用；填上后私聊/被@时模型会在需要最新信息时自动调用
BAIDU_QIANFAN_API_KEY=
# auto = 千帆 Key > 通义 API > 必应兜底；dashscope / baidu / bing / off
WEB_SEARCH_PROVIDER=auto
# 通义联网搜索用的模型
WEB_SEARCH_MODEL=qwen-plus
# 1 允许联网，0 关闭
WEB_SEARCH_ENABLED=1

# ================= 高级：自定义人设（可选）=================
# 新安装自动使用通用 persona.txt，不附带个人角色、圈内隐语或识图资料。
# 自定义人格保存在实例数据目录的 personas/，通过控制台显式导入、激活。
# PERSONA_DIR= 可指定另一私有目录（相对路径以 .env 所在目录为准）。
# PERSONA_FILE= 可指定私有人格文件，PERSONA=可写单行提示词；均需自己明确设置。
# 私有语料：数据目录下 poke-replies.txt、profile.local.json、vision-knowledge/。
# 这些文件不属于公共默认设置，不纳入 Git。参考文件也不会自动激活。

# ================= 本地控制台 =================
ADMIN_ENABLED=1
# 控制台固定监听部署环境 127.0.0.1
ADMIN_PORT=8787
# 管理员 QQ 号，逗号分隔；留空时群总结等沿用公开范围。
# QQ 清除记忆指令必须显式配置管理员；/help 人人可用。
ADMIN_USERS=
# 允许私聊的 QQ（逗号分隔）；留空 = 只回管理员和控制台添加过的私聊
PRIVATE_WHITELIST=

# ================= 视觉服务商与总结预算 =================
# 识图思考强度：none / low / high（none 最稳）
VISION_REASONING=none
# 单次识图 token 预算
VISION_MAX_TOKENS=300
VISION_PROVIDER=dashscope
SUMMARY_PROVIDER=deepseek
SUMMARY_MAX_TOKENS=8000
# 同时准备两个群的报告；实际发送串行，群间至少间隔 5 秒
SUMMARY_CONCURRENCY=2
# 每群历史拉取、排队、生成与修正的合计时限（2～30 分钟）
SUMMARY_TASK_TIMEOUT_MINUTES=6
# 群总结转发资料里的图片独立使用通义千问；留空沿用 DASHSCOPE_MODEL
SUMMARY_VISION_MODEL=
# 每份报告最多读 6 张参考图片（0～12）；0 仅展开文字
SUMMARY_REFERENCE_MAX_IMAGES=6

# Windows instance and scheduled tasks
BOT_PROFILE=main
BOT_TASK_NAME=DeepSeekQQBot
NAPCAT_DIR=
NAPCAT_TASK_NAME=NapCatQQ

# 白名单群早晚安：仅使用人格固定语库，不调用AI；默认关闭。
QUIET_GREETINGS_ENABLED=0

# 表情包学习独立于聊天白名单，默认关闭、范围为空。需要 DeepSeek 与 DashScope Key。
STICKER_LEARN_ENABLED=0
STICKER_LEARN_GROUPS=
STICKER_LEARN_PER_HOUR=6

# 普通文字回复配图；模型选图也遵守概率，0=不配图，100=每次尝试。
STICKER_AUTO_RATE=35
STICKER_MAX_PER_REPLY=1
STICKER_SEND_SCOPE=all
STICKER_SEND_GROUPS=
STICKER_PICK_MODE=context
STICKER_COOLDOWN_SECONDS=0

# ================= 文件发送与打包 =================
# /发文件 与 Python 脚本结果共用的单文件上限（MB，1～8192）
FILE_UPLOAD_MAX_MB=1024
# 打包格式：zip 或 7z（7z 需要本机安装 7-Zip，可用 SEVEN_ZIP_PATH 指定位置）
ARCHIVE_FORMAT=zip
# 压缩次数 1～5：2 表示把上一次的压缩包再压一遍（生成 name.2.zip 这类嵌套包）
ARCHIVE_PASSES=1
# 7-Zip 可执行文件路径；留空自动找常见安装位置
SEVEN_ZIP_PATH=

# ================= 实例隔离（并行跑两个号时才需要）=================
# 一个进程只连一个 OneBot；换号迁移期间用这几项把配置/数据/日志分开，代码目录只有一份。
# BOT_ENV_FILE=./.env.new
# BOT_DATA_DIR=./data-new
# BOT_LOG_DIR=./logs-new
# 实例名（main / new），重启时只杀自己这个 profile 的进程
# （BOT_PROFILE 见下方 Windows 段）

# ================= 人设文件（一般由控制台管理）=================
# ACTIVE_PERSONA=夜璃
# PERSONA_DIR=./data/personas
# PERSONA_FILE=./data/persona.txt
# PERSONA=直接写整段提示词（优先于上面两项，一般不用）

# ================= 模型接入方式 =================
# deepseek / 其他，只用于控制台预填地址；真正生效的是 DEEPSEEK_BASE_URL + DEEPSEEK_MODEL
MODEL_PROVIDER=deepseek

# ================= 静音 / 安静时段 / 限额 =================
# 完全静音的群（连被@也不回），逗号分隔；换号迁移期间让旧号闭嘴用
MUTED_GROUPS=
# 安静时段，如 23:30-08:00；留空=不启用
QUIET_HOURS=
# 安静时段是否彻底静音：1=连@和私聊都不回（默认）0=只挡主动搭话
QUIET_HOURS_BLOCK_ALL=1
# 机器人没回复的消息是否也记入上下文（1=记，像真人在场）
CONTEXT_REMEMBER_ALL=1
# 最小回复预算（字）：0=完全跟随对方长度；大于0时短问题也至少这么多字
REPLY_MIN_BUDGET=0
# 回复末尾显示思考耗时（调试用）
REPLY_TIMING_ENABLED=0
# 反检测：装饰符号保留比例、打字延迟范围、每会话每小时额度与最小间隔
EMOJI_KEEP_RATE=0.2
HUMAN_DELAY_MIN_MS=600
HUMAN_DELAY_MAX_MS=2500
RATE_LIMIT_PER_HOUR=25
RATE_LIMIT_AT_PER_HOUR=45
RATE_LIMIT_MIN_GAP_MS=4000
RATE_LIMIT_WAIT_MAX_MS=8000

# ================= 长期记忆 =================
# 被近期窗口挤走的旧消息压缩成摘要；LONG_MEMORY_MAX_CHARS 太小会导致反复超预算整理失败
LONG_MEMORY_ENABLED=1
LONG_MEMORY_MAX_CHARS=2500
LONG_MEMORY_INTERVAL_MS=600000

# ================= 拍一拍 =================
POKE_REPLY_ENABLED=1
POKE_COOLDOWN_MS=8000
# POKE_REPLIES_FILE=./data/poke-replies.txt

# ================= 定时指令（定时 @ 某人发固定内容）=================
DAILY_PING_ENABLED=0
DAILY_PING_TIME=00:00
DAILY_PING_GROUP=
DAILY_PING_TARGET=
DAILY_PING_TEXT=
DAILY_PING_CHAIN_ENABLED=1
DAILY_PING_CHAIN_TEXT=
DAILY_PING_CHAIN_WINDOW_MS=90000
DAILY_PING_CHAIN_MATCH=抓到.*猪猪

# ================= 盯人回复 =================
TARGET_WATCH_ENABLED=0
TARGET_WATCH_GROUP=
TARGET_WATCH_USER=
TARGET_WATCH_INTERVAL_MS=15000

# ================= 群名片核对与踢人 =================
ID_CHECK_ENABLED=1
ID_CHECK_GROUPS=
# 谁能触发 /id_check 和 /id_check_kick（逗号分隔）。
# ⚠ 留空 = 谁都能触发；开启踢人时务必填写，否则群友可以让机器人批量移出成员。
ID_CHECK_OPERATORS=
ID_CHECK_REMINDER=请按本群要求修改群名片，例如「编号 昵称」。
ID_CHECK_PER_MESSAGE=0
ID_CHECK_SKIP=
ID_CHECK_SKIP_BOTS=1
ID_CHECK_KICK_ENABLED=1
ID_CHECK_KICK_WINDOW_MS=300000
ID_CHECK_KICK_GAP_MS=800

# ================= 识图扩展 =================
# provider=deepseek 时读图用哪个模型（deepseek-flash 最快；deepseek-v4-pro 不能读图）
VISION_MODEL=deepseek-flash
# 任意 OpenAI 兼容的多模态接口（也可在控制台里加多条）
VISION_CUSTOM_BASE_URL=
VISION_CUSTOM_API_KEY=
VISION_CUSTOM_MODEL=
# 识图结果缓存：开关、上限（MB/条数）、保留天数
VISION_CACHE_ENABLED=1
VISION_CACHE_MAX_MB=256
VISION_CACHE_MAX_ENTRIES=2000
VISION_CACHE_DAYS=30

# ================= 表情包选项 =================
STICKERS_ENABLED=1
# 打标模型：auto=有通义用通义，否则 DeepSeek，再否则自定义
STICKER_TAG_PROVIDER=auto
# 私聊也学习表情包（默认关）
STICKER_LEARN_PRIVATE=0

# ================= Python 插件 =================
# python 可执行文件路径；留空用 PATH 里的 python
PYTHON_PATH=
